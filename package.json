{
  "name": "trading-journal-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "check:env": "node scripts/check-env.mjs",
    "prebuild": "node scripts/check-env.mjs && node seo/generate.mjs",
    "postbuild": "node scripts/check-env.mjs --dist && node seo/audit.mjs",
    "vercel:env": "node scripts/vercel-env.mjs",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes,database",
    "seo:generate": "node seo/generate.mjs",
    "seo:image": "node seo/og-image.mjs",
    "seo:check": "node seo/audit.mjs",
    "seo": "npm run seo:generate && npm run seo:image && npm run seo:check"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lightweight-charts": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  }
}
