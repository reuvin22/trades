rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // A trader's own account record: identity, journal defaults and plan.
    match /users/{uid} {
      allow read: if isOwner(uid);
      // Only a confirmed address may write, and never to someone else's doc.
      allow create, update: if isOwner(uid) && isVerified();
      allow delete: if false;

      // Journal entries live under the owning account.
      match /trades/{tradeId} {
        allow read: if isOwner(uid);
        allow create, update, delete: if isOwner(uid) && isVerified();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }

  function isOwner(uid) {
    return request.auth != null && request.auth.uid == uid;
  }

  // Mirrors the app's gate: unverified sessions cannot write anything.
  function isVerified() {
    return request.auth.token.email_verified == true;
  }
}
