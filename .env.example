# Firebase WEB app config (safe to expose in a client bundle).
# Firebase Console -> Project settings -> General -> Your apps -> Web app -> SDK setup.
# Copy this file to .env.local and fill in the blanks.
#
# NOTE: the service account key (trading.json) is an ADMIN credential and must
# never appear here or anywhere else in the client bundle.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=trading-journal-43d07.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=trading-journal-43d07
VITE_FIREBASE_STORAGE_BUCKET=trading-journal-43d07.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# SERVER-ONLY secrets. No VITE_ prefix — that would inline them into the client
# bundle and publish them. Set these in Vercel > Settings > Environment
# Variables, never in a committed file.
# ---------------------------------------------------------------------------

# Brevo transactional email key (can send mail as you — treat as a password).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=RagDex

# OpenRouter, for the behavioural-leak card and the AI Coach.
# Key from https://openrouter.ai/keys — starts with sk-or-v1-
OPENROUTER_API_KEY=
# Optional. A single model slug, or a comma-separated fallback chain.
# Defaults to a chain of free models; see api/_openrouter.ts
OPENROUTER_MODEL=

# The full JSON of the Firebase service account, on one line.
FIREBASE_SERVICE_ACCOUNT=

# Absolute URL of the deployment, used to build the verification return link.
APP_URL=http://localhost:5173
